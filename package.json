{
  "name": "fastlove-monorepo",
  "private": true,
  "version": "1.0.5",
  "description": "FastLove multi-platform product repository",
  "scripts": {
    "admin:dev": "npm --prefix apps/admin-web run dev",
    "admin:start": "npm --prefix apps/admin-web run start",
    "admin:build": "npm --prefix apps/admin-web run build",
    "android:build": "cd apps/android && gradle --no-daemon assembleDebug",
    "android:test": "cd apps/android && gradle --no-daemon testDebugUnitTest",
    "android:device-test": "cd apps/android && gradle --no-daemon connectedDebugAndroidTest",
    "android:verify": "cd apps/android && gradle --no-daemon testDebugUnitTest lintDebug assembleDebug jacocoTestReport",
    "admin:test": "npm --prefix apps/admin-web test",
    "security:check": "node scripts/security-check.mjs",
    "security:verify": "node scripts/run_local_security_pipeline.mjs",
    "android:xml:check": "python3 scripts/validate_android_xml.py"
  },
  "engines": {
    "node": ">=20"
  }
}
